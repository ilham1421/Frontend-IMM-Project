generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// Model User (Superadmin & Admin PIKOM)
// ==========================================
model User {
  id         Int      @id @default(autoincrement())
  nama       String
  email      String   @unique
  password   String
  role       String   @default("admin") // "superadmin" | "admin"
  komisariat String?
  aktif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// Model Pengaturan (Status Pendaftaran, Info Kegiatan)
// ==========================================
model Pengaturan {
  id              Int      @id @default(autoincrement())
  namaKegiatan    String   @default("Darul Arqam Dasar")
  deskripsi       String   @default("")
  tanggalMulai    String   @default("")
  tanggalSelesai  String   @default("")
  lokasi          String   @default("")
  kuotaPeserta    Int      @default(100)
  batasRegistrasi String   @default("")
  statusBuka      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// Model Persyaratan (Dinamis)
// ==========================================
model Persyaratan {
  id        Int      @id @default(autoincrement())
  nama      String
  jenis     String   @default("file") // "file" | "teks" | "checkbox"
  wajib     Boolean  @default(true)
  urutan    Int      @default(0)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// Model Peserta (Pendaftar DAD)
// ==========================================
model Peserta {
  id            Int      @id @default(autoincrement())
  noPendaftaran String   @unique
  namaLengkap   String
  nim           String
  tempatLahir   String
  tanggalLahir  String
  jenisKelamin  String
  email         String
  noHp          String
  universitas   String
  fakultas      String
  prodi         String
  komisariat    String
  alamat        String
  status        String   @default("Menunggu") // "Menunggu" | "Terverifikasi" | "Ditolak"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  berkas BerkasPeserta[]
}

// ==========================================
// Model Berkas Peserta (File Upload)
// ==========================================
model BerkasPeserta {
  id           Int      @id @default(autoincrement())
  pesertaId    Int
  namaBerkas   String
  namaFile     String
  path         String
  createdAt    DateTime @default(now())

  peserta Peserta @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
}
